# Create your bot at https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=

# Required. The parent folder holding your repos. A channel named #my-repo runs
# in BASE_FOLDER/my-repo, so channel names must match folder names.
BASE_FOLDER=~/repos

# Optional allowlist of channel IDs. Leave blank to allow any channel whose name
# matches a folder under BASE_FOLDER.
DISCORD_CHANNEL_IDS=

# Which agent to use by default: codex or claude. Switch per channel with /agent.
AGENT=codex

# Executable name on PATH, or a path. No arguments here.
CODEX_BIN=codex
CLAUDE_BIN=claude

# Leave blank to use the agent's own configuration. The bot never picks a model
# for you. REASONING_EFFORT applies to codex only.
MODEL=
REASONING_EFFORT=

# Optional overall deadline in seconds. Zero means no deadline.
MAX_RUN_SECONDS=0

# Relative to this file.
DISCORD_LOG_DIR=logs
BOT_STATE_DIR=state
