# Create your bot in https://discord.com/developers/applications
DISCORD_BOT_TOKEN=
DISCORD_USER_ID=
DISCORD_CHANNEL_ID=

# Required: the workspace Codex should operate on (absolute or relative to this file).
# Set this to the local workspace where Codex should operate.
CODEX_WORKDIR=.

# Executable name on PATH or path to Codex. No command arguments here.
CODEX_BIN=codex
# Optional overall deadline in seconds. Zero allows long-running tasks.
CODEX_MAX_RUN_SECONDS=0

# Leave both blank to use your Codex configuration. The bot never picks a model for you.
CODEX_MODEL=
CODEX_REASONING_EFFORT=

CODEX_STARTUP_WARN_SECONDS=30
CODEX_IDLE_WARN_SECONDS=120
DISCORD_HEARTBEAT_SECONDS=30
BOT_STATE_DIR=state

# Relative to this file; a separate timestamped log is created for every launch.
DISCORD_LOG_DIR=logs
